AIP_HOST=0.0.0.0
AIP_PORT=4173
AIP_DB_PATH=/app/data/aip-monitor.sqlite
AIP_REQUIRE_AUTH=1
AIP_ADMIN_PASSWORD=change-this-admin-password
AIP_COLLECTOR_TOKEN=change-this-collector-token
AIP_COLLECTOR_TOKEN_DAYS=30
AIP_ALLOWED_ORIGINS=https://monitor.example.com
AIP_COOKIE_SECURE=1
AIP_L1_DAILY_USD=0.50
AIP_L1_DAILY_VERSIONS=100

# 模型密钥按“管理 → 模型接口”中填写的环境变量名提供。
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
